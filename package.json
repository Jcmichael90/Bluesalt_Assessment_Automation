{
  "name": "automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "cypress run --browser chrome --headless --config video=false,screenshotOnRunFailure=false",
    "test:bdd": "cypress run --browser chrome --headless --spec 'cypress/e2e/features/**/*.feature' --config video=false,screenshotOnRunFailure=false",
    "test:e2e": "cypress run --browser chrome --headless --spec 'cypress/e2e/**/*.cy.js' --config video=false,screenshotOnRunFailure=false",
    "cypress:open": "cypress open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^22.1.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.1.1",
    "cypress": "^15.13.0"
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": false,
    "stepDefinitions": "cypress/e2e/step-definitions/**/*.steps.js"
  }
}